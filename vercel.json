{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "cd expo && npm install --legacy-peer-deps && npx expo export -p web",
  "outputDirectory": "expo/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
